<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AC_GroupHAnywhere</AssemblyName>
    <RootNamespace>AC_GroupHAnywhere</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Aicomi's BepInEx folder, after BepInEx has run once. Override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files\Aicomi\BepInEx</GameDir>
    <!-- Some installs keep the generated assemblies in interop-Aicomi\interop. Override with -p:InteropDir=... -->
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)\interop</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(InteropDir)\ILGLib.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
